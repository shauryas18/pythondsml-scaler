def multi(*nums):
    p = 1
    for i in range(len(nums)):
        p = p * nums[i]
    return p
print(multi(1, 2, 3, 4))

# multiplication using args
def pro(*args):
    p=1
    for num in args:
        p=p*num
    return p
print(pro(2,3,4))
